<!DOCTYPE html>
<html>

<head>
    <title>Birthday Cake Order Form</title>

    <style>
        body {
            font-size: 24px;
        }

        h1 {
            font-size: 40px;
        }

        input {
            font-size: 20px;
            width: 100px;
            height: 30px;
        }

        button {
            font-size: 22px;
            padding: 8px 15px;
        }
    </style>
</head>

<body>

    <h1>Birthday Cake Order Form</h1>

    <fieldset>

        Number of 1/2kg Cakes:
        <input type="text" id="small">

        <br><br>

        Number of 1kg Cakes:
        <input type="text" id="medium">

        <br><br>

        Number of 2kg Cakes:
        <input type="text" id="large">

        <br><br>

        Tip:

        <label>
            <input type="radio"
                   value="10"
                   name="tip">
            10%
        </label>

        <label>
            <input type="radio"
                   value="15"
                   name="tip"
                   checked="checked">
            15%
        </label>

        <label>
            <input type="radio"
                   value="20"
                   name="tip">
            20%
        </label>

        <br><br>

        <button id="submit">
            Calculate Order
        </button>

    </fieldset>


    <p>
        Cost of order:
        <span id="price"></span>
    </p>


    <script>

        document.getElementById("submit")
            .addEventListener("click", calculateOrder);


        function calculateOrder() {

            var small =
                parseInt(
                    document.getElementById("small").value
                );

            var medium =
                parseInt(
                    document.getElementById("medium").value
                );

            var large =
                parseInt(
                    document.getElementById("large").value
                );


            var tip =
                parseInt(
                    document.querySelector(
                        'input[name="tip"]:checked'
                    ).value
                );

            var total =
                (small * 100) +
                (medium * 200) +
                (large * 400);

            var tax =
                total * 0.09;


            var totalAfterTax =
                total + tax;

            var tipAmount =
                totalAfterTax * tip / 100;


            var finalCost =
                totalAfterTax + tipAmount;


            document.getElementById("price").innerHTML =
                finalCost.toFixed(2);
        }

    </script>

</body>

</html>
