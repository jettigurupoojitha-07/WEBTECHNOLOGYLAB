<!--BMI CALCULATOR-->

<!DOCTYPE html>
<html>

<head>
    <title>Experiment 5</title>
     <style>
        body {
            font-size: 20px;
        }

        h1 {
            font-size: 35px;
        }

        h2 {
            font-size: 28px;
        }

        input {
            font-size: 18px;
        }

        button {
            font-size: 18px;
            padding: 5px 10px;
        }
    </style>

</head>

<body>

    <h1>JavaScript DOM and Events</h1>
    <h2>Shortest and Longest Word</h2>

    <button onclick="findWords()">Find Words</button>

    <p id="result"></p>
    <h2>BMI Calculator</h2>

    Weight:
    <input type="text" id="weight">

    <br><br>

    Height:
    <input type="text" id="height">

    <br><br>

    <button onclick="calculate()">Calculate BMI</button>

    <p>Your BMI is: <span id="score"></span></p>

    <p>Your body type is: <span id="type"></span></p>


    <script>
        function findWords() {

            var text = "Web Development Tutorial";

            var words = text.split(" ");

            var shortest = words[0];
            var longest = words[0];

            for (var i = 1; i < words.length; i++) {

                if (words[i].length < shortest.length) {
                    shortest = words[i];
                }

                if (words[i].length > longest.length) {
                    longest = words[i];
                }
            }

            document.getElementById("result").innerHTML =
                "Shortest: " + shortest + "<br>" +
                "Longest: " + longest;
        }
        function calculate() {

            var weight =
                parseFloat(document.getElementById("weight").value);

            var height =
                parseFloat(document.getElementById("height").value);

            var bmi = weight / (height * height);

            document.getElementById("score").innerHTML =
                bmi.toFixed(2);

            if (bmi < 18) {

                document.getElementById("type").innerHTML =
                    "Underweight";

            }
            else if (bmi <= 25) {

                document.getElementById("type").innerHTML =
                    "Normal";

            }
            else if (bmi <= 30) {

                document.getElementById("type").innerHTML =
                    "Overweight";

            }
            else {

                document.getElementById("type").innerHTML =
                    "Obese";
            }
        }

    </script>

</body>

</html>



