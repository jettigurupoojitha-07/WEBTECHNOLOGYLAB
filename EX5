<!DOCTYPE html>
<html>

<head>
    <title>Currency Converter</title>

    <style>
        body {
            font-size: 70px;
        }

        h1 {
            font-size: 70px;
        }

        input, select {
            font-size: 80px;
            padding: 5px;
        }

        button {
            font-size: 80px;
            padding: 8px 15px;
        }
    </style>
</head>

<body>

    <h1>Currency Converter</h1>

    <fieldset>

        Convert:
        <input type="text" id="data">

        <select id="from">
            <option>Indian Rupee</option>
            <option>US Dollar</option>
        </select>

        to

        <select id="to">
            <option>US Dollar</option>
            <option>Indian Rupee</option>
        </select>

        <br><br>

        <button onclick="convert()">Calculate</button>

        <span id="answer"></span>

    </fieldset>


    <script>

        function convert() {

            var data =
                parseFloat(document.getElementById("data").value);

            var from =
                document.getElementById("from");

            var to =
                document.getElementById("to");


            var fromIndex = from.selectedIndex;

            var toIndex = to.selectedIndex;


            var fromValue =
                from.options[fromIndex].text;

            var toValue =
                to.options[toIndex].text;


            var result;


            if (fromValue == "Indian Rupee" &&
                toValue == "US Dollar") {

                result = data * 0.015;

            }

            else if (fromValue == "US Dollar" &&
                     toValue == "Indian Rupee") {

                result = data * 67.12;

            }

            else {

                result = data;
            }


            document.getElementById("answer").innerHTML =
                result.toFixed(2) + " " + toValue;
        }

    </script>

</body>

</html>




