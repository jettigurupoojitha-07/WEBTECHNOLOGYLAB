import { useState, useEffect } from "react";
import axios from "axios";
import "./App.css";
const API = "http://localhost:5000/students";
function App() {
  const [students, setStudents] = useState([]);
  const [form, setForm] = useState({
    regNo: "",
    name: "",
    department: "",
    email: "",
    cgpa: "",
  });
  const [editId, setEditId] = useState(null);
  const fetchStudents = async () => {
    try {
      const res = await axios.get(API);
      setStudents(res.data);
    } catch (err) {
      console.error(err);
      alert("Backend not connected. Make sure port 5000 is running.");
    }
  };
  useEffect(() => {
    fetchStudents();
  }, []);
  const handleChange = (e) => {
    setForm({ ...form, [e.target.name]: e.target.value });
  };
  const handleSubmit = async (e) => {
    e.preventDefault();
    const data = { ...form, cgpa: Number(form.cgpa) };
    try {
      if (editId) {
        await axios.put(`${API}/${editId}`, data);
        alert("Student updated successfully!");
      } else {
        await axios.post(API, data);
        alert("Student added successfully!");
      }
      setForm({
        regNo: "",
        name: "",
        department: "",
        email: "",
        cgpa: "",
      });
      setEditId(null);
      fetchStudents();
    } catch (err) {
      console.error(err);
      alert("Unable to save student.");
    }
  };
  const handleEdit = (student) => {
    setEditId(student._id);
    setForm({
      regNo: student.regNo,
      name: student.name,
      department: student.department,
      email: student.email,
      cgpa: String(student.cgpa),
    });
  };
  const handleDelete = async (id) => {
    if (!window.confirm("Delete this student?")) return;
    try {
      await axios.delete(`${API}/${id}`);
      fetchStudents();
    } catch (err) {
      console.error(err);
      alert("Unable to delete student.");
    }
  };
  const resetForm = () => {
    setEditId(null);
    setForm({
      regNo: "",
      name: "",
      department: "",
      email: "",
      cgpa: "",
    });
  };
  return (
    <div className="app">
      <header>
        <h1>Student Management System</h1>
        <p>Full Stack Application using React, Node.js and MongoDB</p>
      </header>

      <main>
        <section className="card">
          <h2>{editId ? "Update Student" : "Add New Student"}</h2>

          <form onSubmit={handleSubmit}>
            <div className="form-grid">
              <input name="regNo" placeholder="Register Number"
                value={form.regNo} onChange={handleChange} required />
              <input name="name" placeholder="Student Name"
                value={form.name} onChange={handleChange} required />
              <input name="department" placeholder="Department"
                value={form.department} onChange={handleChange} required />
              <input name="email" type="email" placeholder="Email"
                value={form.email} onChange={handleChange} required />
              <input name="cgpa" type="number" min="0" max="10"
                step="0.01" placeholder="CGPA"
                value={form.cgpa} onChange={handleChange} required />
            </div>

            <button type="submit">
              {editId ? "Update Student" : "Add Student"}
            </button>

            {editId && (
              <button type="button" className="cancel" onClick={resetForm}>
                Cancel
              </button>
            )}
          </form>
        </section>

        <section className="card">
          <h2>Student Records ({students.length})</h2>

          <div className="table-container">
            <table>
              <thead>
                <tr>
                  <th>Register No.</th>
                  <th>Name</th>
                  <th>Department</th>
                  <th>Email</th>
                  <th>CGPA</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {students.length === 0 ? (
                  <tr>
                    <td colSpan="6">No student records found.</td>
                  </tr>
                ) : (
                  students.map((student) => (
                    <tr key={student._id}>
                      <td>{student.regNo}</td>
                      <td>{student.name}</td>
                      <td>{student.department}</td>
                      <td>{student.email}</td>
                      <td>{student.cgpa}</td>
                      <td>
                        <button type="button" onClick={() => handleEdit(student)}>
                          Edit
                        </button>
                        <button type="button" className="delete"
                          onClick={() => handleDelete(student._id)}>
                          Delete
                        </button>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
  );
}

export default App;



