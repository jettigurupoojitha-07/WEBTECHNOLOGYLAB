import Sidebar from './components/Sidebar'
import { useState } from 'react'
import './App.css'
import StatCard from './components/StatCard'
import Navbar from './components/Navbar'
import profileImage from "./assets/profile.jpg"
function App() {
  const [darkMode, setDarkMode] = useState(false)
  const [task, setTask] = useState('')
  const [tasks, setTasks] = useState([])
  const [search, setSearch] = useState('')
  const courses = [
    { name: 'ReactJS', progress: 80 },
    { name: 'Python', progress: 70 },
    { name: 'Data Science', progress: 60 },
    { name: 'Database Management', progress: 90 }
  ]
const addTask = () => {
  if (task.trim() === '') {
    alert('Please enter a task')
  } else {
    const newTask = {
      name: task,
      completed: false
    }
    setTasks([...tasks, newTask])
    setTask('')
  }
}
const deleteTask = (index) => {
  const updatedTasks = tasks.filter((_, i) => i !== index)
  setTasks(updatedTasks)
}
const toggleTask = (index) => {
  const updatedTasks = [...tasks]
  updatedTasks[index].completed =
    !updatedTasks[index].completed
  setTasks(updatedTasks)
}
  return (
    <div className={darkMode ? 'app dark' : 'app'}>
      {/* Navigation Bar */}
      <Navbar
        darkMode={darkMode}
        setDarkMode={setDarkMode}
      />
      <Sidebar />
      <main className="dashboard"></main>
      <main className="dashboard">
        {/* Profile Section */}
        <section className="profile-section">
          <img
            src={profileImage}
            alt="Student Profile"
          />
          <div>
            <h2>Guru Poojitha</h2>
            <p>Computer Science Student</p>
          </div>
        </section>
        {/* Search Bar */}
        <section className="search-section">
          <input
            type="text"
            placeholder="Search courses..."
            value={search}
            onChange={(e) => setSearch(e.target.value)}
          />
        </section>
        {/* Welcome Section */}
        <section id="home" className="welcome">
          <h1>Welcome, Student! 👋</h1>
          <p>
            Track your learning progress and manage your studies.
          </p>
        </section>
        {/* Statistics Cards */}
        <section className="stats">
          <StatCard
            title="Courses"
            value="6"
          />
          <StatCard
            title="Completed"
            value="4"
          />
          <StatCard
            title="Assignments"
            value="8"
          />

          <StatCard
            title="Attendance"
            value="92%"
          />
        </section>
        {/* Course List */}
        <section id="courses" className="section">
          <h2>My Courses</h2>
          <div className="course-list">
            {courses
              .filter((course) =>
                course.name
                  .toLowerCase()
                  .includes(search.toLowerCase())
              )
              .map((course, index) => (
                <div
                  className="course-card"
                  key={index}
                >

                  <h3>{course.name}</h3>
                  <p>Continue learning</p>
                  {/* Progress Bar */}
                  <div className="progress-bar">
                    <div
                      className="progress"
                      style={{
                        width: `${course.progress}%`
                      }}
                    ></div>
                  </div>
                  {/* Percentage */}
                  <span>
                    {course.progress}% completed
                  </span>
                </div>
              ))}
          </div>
        </section>
        {/* Task Section */}
        <section id="tasks" className="section">
          <h2>Add a Task</h2>
          <div className="task-box">
            <input
              type="text"
              placeholder="Enter your task"
              value={task}
              onChange={(e) => setTask(e.target.value)}
            />
            <button onClick={addTask}>
              Add Task
            </button>
          </div>
         <div className="task-list">
              {tasks.map((item, index) => (
                    <div className="task-item" key={index}>

                        <input
                                   type="checkbox"
                                   checked={item.completed}
                                  onChange={() => toggleTask(index)}
                          />
                        <span className={item.completed ? 'completed' : ''}>
                                {item.name}
                        </span>
                        <button onClick={() => deleteTask(index)}>
                                Delete
                        </button>
                     </div>
                ))}
</div>
        </section>
      </main>
    </div>
  )
export default App



