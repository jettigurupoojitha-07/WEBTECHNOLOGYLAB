STYLE.CSS
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #eeeeee;
}

/* HEADER */

.header {
    width: 100%;
    background: linear-gradient(90deg, #7b1fa2, #8e24aa);
    color: white;
    text-align: center;
    position: relative;
    padding: 10px;
}

.profile {
    position: absolute;
    left: 20px;
    top: 10px;
}

.profile img {
    width: 55px;
    height: 55px;
    border-radius: 5px;
}

.title h1 {
    margin: 8px 0;
    font-size: 20px;
}

.title p {
    margin: 0;
    font-size: 13px;
}

.top-icons {
    position: absolute;
    right: 20px;
    top: 10px;
}

.top-icons span {
    background: white;
    color: #7b1fa2;
    padding: 3px 5px;
    margin: 2px;
}

/* NAVIGATION */

nav {
    margin-top: 10px;
    background: #b3e5e5;
    padding: 5px;
}

nav a {
    color: #333;
    text-decoration: none;
    margin: 0 25px;
    font-size: 12px;
    font-weight: bold;
}

nav a:hover {
    color: #7b1fa2;
}

/* INTRO */

.intro {
    background: #238fa0;
    color: white;
    text-align: center;
    padding: 18px;
}

.intro h2 {
    margin: 0 0 8px;
    font-size: 20px;
}

.intro p {
    margin: 0;
    font-size: 13px;
}

/* TECHNOLOGIES */

.technologies {
    display: flex;
    justify-content: space-around;;
    flex-wrap:wrap;
    padding: 20px;
    background: #f2f2f2;
}

.tech{
    width:23%;
    background:#3f4f59;
    color:white;
    display:inline-block;
    vertical-align:top;
    margin:8px;
    padding:15px;
    box-sizing:border-box;
    text-align:center;
    min-height:180px;   /* Increased height */
}

.tech img{
    width:60px;
    height:60px;
}

.tech h3 {
   margin:10px 0;
   font-size:28px;
}

.tech p{
    font-size:16px;
    line-height:1.5;
    margin-top:10px;
    color:white;
}

.html {
    background: #263238;
}

.css {
    background: #37474f;
}

.javascript {
    background: #455a64;
}

.php {
    background: #546e7a;
}

/* PROFILE SECTION */

.profiles {
    display: flex;
    justify-content: center;
    gap: 20px;
    background: #0277a8;
    padding: 15px;
}

.profile-box {
    width: 28%;
    text-align: center;
    color: white;
}

.profile-box img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 3px solid white;
}

.profile-box h3 {
    margin: 5px;
    font-size: 14px;
}

.profile-box p {
    font-size: 11px;
}

/* FOOTER */

footer {
    background: #eeeeee;
    text-align: left;
    padding: 10px 20px;
    font-size: 10px;
    color: #555;
}

/* RESPONSIVE */

@media (max-width: 768px) {

    .technologies {
        flex-wrap: wrap;
    }

    .tech {
        width: 45%;
    }

    .profiles {
        flex-direction: column;
        align-items: center;
    }

    .profile-box {
        width: 80%;
    }

    nav a {
        display: inline-block;
        margin: 5px;
    }
}


