#Style.css

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial;
}

header{
    height:180px;
    background:linear-gradient(135deg,#4b0083,#8a2be2,#9370db);
    background-size:cover;
    position:relative;
}

.logo{
    width:60px;
    position:absolute;
    top:20px;
    left:20px;
}

header h1{
    color:white;
    text-align:center;
    padding-top:70px;
}

nav ul{
    display:flex;
    list-style:none;
    background:#2c3e50;
}

nav li{
    flex:1;
}

nav a{
    display:block;
    text-align:center;
    padding:12px;
    text-decoration:none;
    color:paleturquoise;
}

.active{
    background:#16a085;
}

nav a:hover{
    background:#1abc9c;
    color:white;
}

.products{
    background:pink;
    padding:30px;
}

.fruitTable{
    margin:auto;
    width:300px;
    border-collapse:collapse;
    overflow:hidden;
    border-radius:15px;
}

.fruitTable th{
    background:green;
    color:white;
    padding:10px;
}

.fruitTable td{
    padding:10px;
    text-align:center;
}

.fruitTable tr:nth-child(even){
    background:#b9ff3b;
}

.fruitTable tr:nth-child(odd){
    background:green;
    color:white;
}

.fruitTable img{
    width:40px;
    height:40px;
}

.forms{

    background:url("laptop.png");

    background-size:cover;
    background-position:center;
    background-repeat: no-repeat;

    display:flex;

    justify-content:center;
    align-items:center;
    gap:40px;
    padding:70px 120px;
}

.login,
.signup{

    background:rgba(255,255,255,0.95);

    width: 320px;
    min-height:390px;

    padding:30px;

    border-radius:18px;

    box-shadow:0 0 15px gray;
}

.login h2,
.signup h2{

    text-align:center;

    margin-bottom:25px;
    text-align:center;
    font-size:28px;
}

input{

    width:100%;

    padding:13px;

    margin:12px 0;

    border:1px solid #ccc;
    border-radius:4px;
    font-size:15px;
}

input:focus{

    background:#ffffcc;

    border:2px solid blue;
}

button{

    width:100%;

    padding:13px;

    background:#0d6efd;

    color:white;

    border:none;
    border-radius:4px;

    cursor:pointer;

    margin-top:15px;
    font-size:16px;
}

button:hover{

    background:green;
}

footer{

    background:#ffe6c7;

    padding:20px;
    text-align:left;
}

footer h3{

    font-style:italic;
}

footer p{

    font-weight:bold;
}
