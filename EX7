    $("#ancestors").click(function() {

        if (selectedEmployee == null) {

            alert("Select an employee first.");

            return;
        }


        $(".project, .team").removeClass("highlight");

        selectedEmployee.parents(".team").addClass("highlight");

        selectedEmployee.parents(".project").addClass("highlight");


        $("#result").text(
            "All Ancestors highlighted: Team and Project"
        );

    });


    // 3. closest()

    $("#projectEmployees").click(function() {

        if (selectedEmployee == null) {

            alert("Select an employee first.");

            return;
        }


        $(".project, .team, .employee")
            .removeClass("highlight");


        let project =
            selectedEmployee.closest(".project");


        project.find(".team").addClass("highlight");

        project.find(".employee").addClass("highlight");


        $("#result").text(
            "All teams and employees in Project Alpha highlighted."
        );

    });


    // 4. siblings()

    $("#teammates").click(function() {

        if (selectedEmployee == null) {

            alert("Select an employee first.");

            return;
        }


        $(".employee").removeClass("highlight");

        selectedEmployee
            .siblings(".employee")
            .addClass("highlight");


        $("#result").text(
            "Teammates highlighted."
        );

    });


    // 5. filter()

    $("#senior").click(function() {

        $(".employee").removeClass("highlight");


        $(".employee")
            .filter(".senior")
            .addClass("highlight");


        $("#result").text(
            "Senior Employees: Kavya and Priya"
        );

    });


    // 6. first()

    $("#first").click(function() {

        $(".employee").removeClass("highlight");

        $(".employee").first().addClass("highlight");

        $("#result").text(
            "First Employee highlighted."
        );

    });


    // 7. last()

    $("#last").click(function() {

        $(".employee").removeClass("highlight");

        $(".employee").last().addClass("highlight");

        $("#result").text(
            "Last Employee highlighted."
        );

    });


    // 8. eq()

    $("#second").click(function() {

        $(".employee").removeClass("highlight");

        $(".employee").eq(1).addClass("highlight");

        $("#result").text(
            "Second Employee highlighted."
        );

    });


    // Reset

    $("#reset").click(function() {

        $(".employee")
            .removeClass("highlight");

        $(".team")
            .removeClass("highlight");

        $(".project")
            .removeClass("highlight");

        selectedEmployee = null;

        $("#result").text(
            "Click an employee to select."
        );

    });

});

</script>

</body>
