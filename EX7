<!DOCTYPE html>
<html>
<head>

    <title>Lab Program 4 - jQuery Effects</title>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>

        body {
            font-family: Arial;
            text-align: center;
            background-color: #f5f5f5;
        }

        .container {
            width: 600px;
            margin: 30px auto;
        }

        h1 {
            color: #174ea6;
        }

        button {
            padding: 10px 15px;
            margin: 5px;
            border: none;
            background-color: #1976d2;
            color: white;
            cursor: pointer;
        }

        button:hover {
            background-color: #0d47a1;
        }

        #product {
            margin-top: 25px;
            padding: 25px;
            background-color: white;
            border: 2px solid #1976d2;
            border-radius: 10px;
            text-align: left;
        }

        #product h2 {
            color: #1976d2;
            text-align: center;
        }

        #message {
            margin-top: 15px;
            color: green;
            font-weight: bold;
        }

    </style>

</head>


<body>

<div class="container">

    <h1>Online Store</h1>

    <button id="show">Show</button>

    <button id="hide">Hide</button>

    <button id="fade">Fade</button>

    <button id="slide">Slide</button>

    <button id="animate">Animate</button>

    <button id="stop">Stop Animation</button>

    <button id="callback">Callback</button>

    <button id="chaining">Chaining</button>


    <div id="product">

        <h2>Product Details</h2>

        <p>
            <b>Product Name:</b> Laptop Pro
        </p>

        <p>
            <b>Price:</b> ₹65,000
        </p>

        <p>
            <b>Category:</b> Electronics
        </p>

        <p>
            <b>Stock Status:</b> Available
        </p>

        <p>
            <b>Description:</b>
            A high performance laptop for work and play.
        </p>

    </div>


    <div id="message"></div>

</div>


<script>

$(document).ready(function() {


    // 1. SHOW

    $("#show").click(function() {

        $("#product").show();

    });


    // 2. HIDE

    $("#hide").click(function() {

        $("#product").hide();

    });


    // 3. FADE

    $("#fade").click(function() {

        $("#product").fadeToggle(1000);

    });


    // 4. SLIDE

    $("#slide").click(function() {

        $("#product").slideToggle(1000);

    });


    // 5. ANIMATE

    $("#animate").click(function() {

        $("#product").animate({

            width: "400px",
            marginLeft: "80px"

        }, 2000);

    });


    // 6. STOP

    $("#stop").click(function() {

        $("#product").stop();

    });


    // 7. CALLBACK

    $("#callback").click(function() {

        $("#message").text("");

        $("#product").fadeOut(1000, function() {

            $("#message").text(
                "Animation completed successfully"
            );

        });

    });


    // 8. CHAINING

    $("#chaining").click(function() {

        $("#product")
            .slideUp(500)
            .slideDown(500)
            .fadeOut(500)
            .fadeIn(500);

    });

});

</script>

</body>
</html>




