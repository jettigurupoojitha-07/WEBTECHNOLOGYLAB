<!DOCTYPE html>
<html>
<head>

    <title>Employee Management Dashboard</title>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>

        body {
            font-family: Arial;
            background-color: #f5f5f5;
            text-align: center;
        }

        .container {
            width: 750px;
            margin: 30px auto;
            background-color: white;
            padding: 20px;
        }

        h1 {
            color: #174ea6;
        }

        input {
            padding: 8px;
            margin: 5px;
            width: 180px;
        }

        button {
            padding: 8px 15px;
            margin: 5px;
            border: none;
            background-color: #1976d2;
            color: white;
            cursor: pointer;
        }

        table {
            width: 100%;
            margin-top: 20px;
            border-collapse: collapse;
        }

        th {
            background-color: #174ea6;
            color: white;
            padding: 10px;
        }

        td {
            border: 1px solid #999;
            padding: 10px;
        }

        tr {
            cursor: pointer;
        }

        .selected {
            background-color: yellow;
        }

        #status {
            margin-top: 15px;
            padding: 10px;
            background-color: #e8f5e9;
            color: green;
            font-weight: bold;
        }

        #dimensions {
            margin-top: 10px;
            color: blue;
            font-weight: bold;
        }

    </style>

</head>


<body>

<div class="container">

    <h1>Employee Management Dashboard</h1>


    <!-- Employee Inputs -->

    <input type="text" id="empId" placeholder="Employee ID">

    <input type="text" id="empName" placeholder="Employee Name">

    <input type="text" id="department" placeholder="Department">

    <br>


    <!-- Buttons -->

    <button id="add">
        Add Employee
    </button>

    <button id="update">
        Update Employee
    </button>

    <button id="remove">
        Remove Employee
    </button>

    <button id="changeColor">
        Change Status Color
    </button>

    <button id="dimensions">
        Show Table Dimensions
    </button>


    <!-- Employee Table -->

    <table id="employeeTable">

        <thead>

            <tr>
                <th>Employee ID</th>
                <th>Employee Name</th>
                <th>Department</th>
            </tr>

        </thead>


        <tbody>

            <tr>
                <td>101</td>
                <td>Riya</td>
                <td>HR</td>
            </tr>

            <tr>
                <td>102</td>
                <td>Arjun</td>
                <td>IT</td>
            </tr>

            <tr>
                <td>103</td>
                <td>Meera</td>
                <td>Finance</td>
            </tr>

        </tbody>

    </table>


    <div id="status">
        Select an employee.
    </div>


    <div id="dimensionResult"></div>

</div>


<script>

$(document).ready(function() {

    let selectedRow = null;


    // 1. GET - Select employee row

    $("#employeeTable tbody").on("click", "tr", function() {

        // Remove previous highlight

        $("tr").removeClass("selected");


        // Highlight selected row

        $(this).addClass("selected");


        // Store selected row

        selectedRow = $(this);


        // GET values using text()

        let id = $(this).find("td:eq(0)").text();

        let name = $(this).find("td:eq(1)").text();

        let department = $(this).find("td:eq(2)").text();


        // Put values into input boxes

        $("#empId").val(id);

        $("#empName").val(name);

        $("#department").val(department);


        $("#status").text(
            "Selected employee details loaded."
        );

    });


    // 2. ADD Employee

    $("#add").click(function() {

        let id = $("#empId").val();

        let name = $("#empName").val();

        let department = $("#department").val();


        if (id == "" || name == "" || department == "") {

            alert("Please enter all employee details.");

            return;
        }


        // Add new row

        $("#employeeTable tbody").append(

            "<tr>" +
            "<td>" + id + "</td>" +
            "<td>" + name + "</td>" +
            "<td>" + department + "</td>" +
            "</tr>"

        );


        $("#status").text(
            "New employee added successfully."
        );


        // Clear inputs

        $("#empId").val("");

        $("#empName").val("");

        $("#department").val("");

    });


    // 3. SET - Update employee

    $("#update").click(function() {

        if (selectedRow == null) {

            alert("Please select an employee.");

            return;
        }


        let id = $("#empId").val();

        let name = $("#empName").val();

        let department = $("#department").val();


        // Set values into table

        selectedRow.find("td:eq(0)").text(id);

        selectedRow.find("td:eq(1)").text(name);

        selectedRow.find("td:eq(2)").text(department);


        $("#status").text(
            "Employee updated successfully."
        );

    });


    // 4. REMOVE employee

    $("#remove").click(function() {

        if (selectedRow == null) {

            alert("Please select an employee.");

            return;
        }


        selectedRow.remove();

        selectedRow = null;


        $("#empId").val("");

        $("#empName").val("");

        $("#department").val("");


        $("#status").text(
            "Employee removed successfully."
        );

    });


    // 5. CSS using css()

    $("#changeColor").click(function() {

        $("#status").css({

            "background-color": "lightblue",

            "color": "darkblue"

        });

    });


    // 6. TABLE DIMENSIONS

    $("#dimensions").click(function() {

        let width = $("#employeeTable").width();

        let height = $("#employeeTable").height();


        $("#dimensionResult").text(

            "Table Width: " + width +
            " px | Table Height: " +
            height + " px"

        );

    });

});

</script>

</body>
</html>

