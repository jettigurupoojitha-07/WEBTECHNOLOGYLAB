<!DOCTYPE html>
<html>
<head>
    <title>Budget Calculator App</title>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>

        body {
            font-family: Arial, sans-serif;
            text-align: center;
        }

        .container {
            width: 600px;
            margin: 30px auto;
        }

        /* Heading */
        .title {
            background-color: black;
            color: white;
            padding: 6px;
            font-weight: bold;
        }

        .question {
            margin-top: 15px;
            font-weight: bold;
            font-size: 14px;
        }

        #amount {
            width: 70px;
            height: 25px;
            text-align: center;
            margin-top: 10px;
        }

        /* Percentage inputs */
        .percentage {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 15px;
        }

        .percentage label {
            font-size: 13px;
            font-weight: bold;
        }

        .percentage input {
            width: 40px;
            height: 22px;
            text-align: center;
        }

        /* Button */
        #evaluate {
            margin-top: 15px;
            padding: 7px 10px;
            background-color: darkblue;
            color: white;
            border: none;
            cursor: pointer;
        }

        /* Result boxes */
        .results {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 15px;
        }

        .box {
            width: 85px;
            height: 55px;
            color: white;
            padding: 7px;
            box-sizing: border-box;
            font-size: 11px;
            text-align: left;
        }

        #roomResult {
            background-color: blue;
        }

        #accessoriesResult {
            background-color: green;
        }

        #emergencyResult {
            background-color: royalblue;
        }

        #savingResult {
            background-color: deeppink;
        }

    </style>
</head>

<body>

<div class="container">

    <div class="title">
        Budget Calculator App
    </div>

    <div class="question">
        Enter Amount that you want to Manage
    </div>

    <input type="number" id="amount" value="15000">


    <div class="question">
        How would you like to divide your money?
    </div>


    <div class="percentage">

        <div>
            <label>Room Rent(%):</label>
            <input type="number" id="room" value="50">
        </div>

        <div>
            <label>Accessories(%):</label>
            <input type="number" id="accessories" value="20">
        </div>

        <div>
            <label>Emergency(%):</label>
            <input type="number" id="emergency" value="20">
        </div>

        <div>
            <label>Saving(%):</label>
            <input type="number" id="saving" value="10">
        </div>

    </div>


    <button id="evaluate">
        Evaluate My Money
    </button>


    <div class="results">

        <div class="box" id="roomResult">
            Room Rent<br>
            <span>Rs.0</span>
        </div>

        <div class="box" id="accessoriesResult">
            Accessories<br>
            <span>Rs.0</span>
        </div>

        <div class="box" id="emergencyResult">
            Emergency<br>
            <span>Rs.0</span>
        </div>

        <div class="box" id="savingResult">
            Saving<br>
            <span>Rs.0</span>
        </div>

    </div>

</div>


<script>

$(document).ready(function() {

    $("#evaluate").click(function() {

        // Get values
        var amount = Number($("#amount").val());

        var room = Number($("#room").val());

        var accessories = Number($("#accessories").val());

        var emergency = Number($("#emergency").val());

        var saving = Number($("#saving").val());


        // Check percentage
        var totalPercentage =
            room + accessories + emergency + saving;


        if (totalPercentage != 100) {

            alert("Percentage values must add up to 100%.");

            return;
        }


        // Calculate amounts
        var roomAmount =
            amount * room / 100;

        var accessoriesAmount =
            amount * accessories / 100;

        var emergencyAmount =
            amount * emergency / 100;

        var savingAmount =
            amount * saving / 100;


        // Display results
        $("#roomResult span")
            .text("Rs." + roomAmount);

        $("#accessoriesResult span")
            .text("Rs." + accessoriesAmount);

        $("#emergencyResult span")
            .text("Rs." + emergencyAmount);

        $("#savingResult span")
            .text("Rs." + savingAmount);

    });

});

</script>

</body>
</html>


