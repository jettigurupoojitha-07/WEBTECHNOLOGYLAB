        Tyre Size Increase
    </button>


    <button id="decreaseTyre">
        Tyre Size Decrease
    </button>


    <button id="reset">
        Reset
    </button>


<script>

$(document).ready(function() {


    // Change car color

    $("#carColor").click(function() {

        $("#carBody").attr("fill", "orange");

    });


    // Change body/roof color

    $("#bodyColor").click(function() {

        $("#carTop").attr("fill", "red");

    });


    // Increase tyre size

    $("#increaseTyre").click(function() {

        $("#wheel1").attr("r", "35");

        $("#wheel2").attr("r", "35");

    });


    // Decrease tyre size

    $("#decreaseTyre").click(function() {

        $("#wheel1").attr("r", "18");

        $("#wheel2").attr("r", "18");

    });


    // Reset everything

    $("#reset").click(function() {

        $("#carBody").attr("fill", "limegreen");

        $("#carTop").attr("fill", "green");

        $("#wheel1").attr("r", "25");

        $("#wheel2").attr("r", "25");

    });

});

</script>


</body>
</html>

