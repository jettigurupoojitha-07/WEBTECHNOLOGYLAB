            <path
                id="carTop"
                d="M130 100 L150 55 L250 55 L270 100 Z"
                fill="green">
            </path>


            <!-- Window -->
            <path
                d="M155 95 L165 65 L195 65 L195 95 Z"
                fill="lightblue">
            </path>


            <path
                d="M205 65 L235 65 L250 95 L205 95 Z"
                fill="lightblue">
            </path>


