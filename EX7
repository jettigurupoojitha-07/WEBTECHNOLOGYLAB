            color: #174ea6;
        }

        label {
            display: block;
            text-align: left;
            margin-top: 10px;
            font-weight: bold;
        }

        input {
            width: 100%;
            height: 30px;
            box-sizing: border-box;
            margin-top: 5px;
        }

        button {
            width: 100%;
            margin-top: 15px;
            padding: 8px;
            background-color: #1268e8;
            color: white;
            border: none;
            font-size: 16px;
            cursor: pointer;
        }

        .result {
            margin-top: 15px;
            padding: 12px;
            background-color: lightblue;
            color: #174ea6;
            font-size: 22px;
            font-weight: bold;
        }

    </style>

</head>

<body>

<div class="container">

    <h2>Addition Calculator</h2>

    <label>Number 1:</label>
    <input type="text" id="num1" placeholder="Number 1">


    <label>Number 2:</label>
    <input type="text" id="num2" placeholder="Number 2">


    <button id="add">
        Addition
    </button>


    <div class="result">
        Result: <span id="answer">0</span>
    </div>

</div>


<script>

$(document).ready(function() {

    $("#add").click(function() {

        // Read values
        let num1 = parseInt($("#num1").val());

        let num2 = parseInt($("#num2").val());


        // Add numbers
        let sum = num1 + num2;


        // Display result
        $("#answer").text(sum);

    });

});

</script>

</body>
